PORT=4000
NODE_ENV=development
MONGO_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/your-db-name
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3000

# Optional Cloudinary image storage.
# Leave blank to use local uploads/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin account used on first backend startup.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMeToAStrongPassword123!
